<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#2D6A9F">
<title>AGI · Gestão de Ponto</title>
<style>
:root{--bg:#EEF1F5;--card:#fff;--borda:#D5DBE3;--txt:#1F2933;--sub:#66727F;--topo:#2D6A9F;--ok:#2B8A3E;--erro:#C92A2A;--aviso:#B26A00;--chip:#E8ECF1}
@media (prefers-color-scheme:dark){:root{--bg:#16191D;--card:#20252B;--borda:#333A43;--txt:#E6EAEE;--sub:#9AA5B1;--ok:#51CF66;--erro:#FF6B6B;--aviso:#FFB454;--chip:#333A43}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--txt);font-family:"Segoe UI",system-ui,-apple-system,Roboto,sans-serif;font-size:15px}
header{background:var(--topo);color:#fff;padding:12px 20px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
header h1{font-size:18px;margin:0}header small{display:block;opacity:.85;font-weight:400;font-size:12px}
button{font:inherit;cursor:pointer}
header button{background:transparent;border:1px solid rgba(255,255,255,.5);color:#fff;border-radius:8px;padding:6px 12px}
main{max-width:1100px;margin:0 auto;padding:16px}
.card{background:var(--card);border:1px solid var(--borda);border-radius:12px;padding:16px;margin-bottom:14px}
.barra{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.barra .esp{flex:1}
.nav{display:flex;align-items:center;gap:8px}
.nav button,.bt{border:1px solid var(--borda);background:var(--card);color:var(--txt);border-radius:8px;padding:8px 14px}
.bt.pri{background:var(--topo);border-color:var(--topo);color:#fff;font-weight:600}
.titulo-folha{font-size:20px;font-weight:700;min-width:210px;text-align:center}
.periodo{color:var(--sub);font-size:13px;text-align:center}
select,input[type=text],input[type=email],input[type=password]{padding:9px 10px;border:1px solid var(--borda);border-radius:8px;background:var(--card);color:var(--txt);font:inherit}
label{font-size:13px;color:var(--sub);display:block;margin-bottom:3px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:14px}
.kpi{background:var(--card);border:1px solid var(--borda);border-radius:12px;padding:12px 14px}
.kpi b{display:block;font-size:24px;margin-top:2px}.kpi span{color:var(--sub);font-size:13px}
h2{font-size:16px;margin:0}
.pessoa{padding:0;overflow:hidden}
.pessoa>.cab{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:12px 16px;background:var(--chip);flex-wrap:wrap}
.pessoa .res{color:var(--sub);font-size:13px}
table{width:100%;border-collapse:collapse}
th,td{padding:8px 10px;text-align:center;border-bottom:1px solid var(--borda);font-variant-numeric:tabular-nums}
th{font-size:12px;color:var(--sub);font-weight:600;text-transform:uppercase;letter-spacing:.3px}
td.esq,th.esq{text-align:left}
tr.dia{cursor:pointer}tr.dia:hover{background:var(--chip)}
tr.det td{background:var(--bg);text-align:left;padding:10px 16px}
.tag{display:inline-block;font-size:12px;padding:2px 8px;border-radius:999px;background:var(--chip);color:var(--sub);margin:0 2px;white-space:nowrap}
.tag.ok{background:rgba(43,138,62,.16);color:var(--ok)}.tag.just{background:rgba(178,106,0,.18);color:var(--aviso)}.tag.inc{background:rgba(201,42,42,.14);color:var(--erro)}
.det ul{list-style:none;margin:0;padding:0}.det li{padding:4px 0;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.det img{height:70px;border-radius:6px;cursor:zoom-in;border:1px solid var(--borda)}
.msg{margin-top:10px;font-size:14px}.erro{color:var(--erro)}.ok{color:var(--ok)}
.vazio{padding:24px;text-align:center;color:var(--sub)}
.oculto{display:none!important}
#login{max-width:380px;margin:40px auto}
#login input{width:100%;margin-bottom:10px}
.pri.largo{width:100%;padding:12px}
.email{display:grid;grid-template-columns:1fr;gap:10px;margin-top:12px}
.demo{background:var(--aviso);color:#fff;text-align:center;font-size:13px;padding:4px}
.zoom{position:fixed;inset:0;background:rgba(0,0,0,.8);display:flex;align-items:center;justify-content:center;z-index:9}.zoom img{max-width:92vw;max-height:92vh;border-radius:8px}
@media print{
  header,.nav,.barra .bt,#painelEmail,#filtros,.demo,#btnsExport{display:none!important}
  body{background:#fff;color:#000}.card,.kpi{border-color:#999;break-inside:avoid}
  tr.det{display:none}.pessoa>.cab{background:#eee}
  #cabImpressao{display:block!important}
}
#cabImpressao{display:none;margin-bottom:10px}
</style>
</head>
<body>
<div id="demo" class="demo oculto">MODO DEMONSTRAÇÃO · dados fictícios, nada é gravado nem enviado</div>
<header>
  <h1>AGI · Gestão de Ponto<small id="quem"></small></h1>
  <button id="sair" class="oculto">Sair</button>
</header>
<main>
  <section id="login" class="card oculto">
    <h2>Entrar</h2>
    <label for="email" style="margin-top:12px">E-mail</label><input id="email" type="email" autocomplete="username">
    <label for="senha">Senha</label><input id="senha" type="password" autocomplete="current-password">
    <button id="entrar" class="bt pri largo">Entrar</button>
    <div id="msgLogin" class="msg erro"></div>
  </section>

  <section id="painel" class="oculto">
    <div id="cabImpressao"><h2>Relatório de ponto</h2></div>
    <div class="card" id="filtros">
      <div class="barra">
        <div class="nav">
          <button id="ant" title="Folha anterior">◀</button>
          <div><div class="titulo-folha" id="tituloFolha"></div><div class="periodo" id="periodo"></div></div>
          <button id="prox" title="Próxima folha">▶</button>
        </div>
        <div class="esp"></div>
        <div><label for="pessoa">Pessoa</label><select id="pessoa"><option value="">Todas</option></select></div>
      </div>
    </div>

    <div class="kpis" id="kpis"></div>
    <div id="lista"></div>

    <div class="card" id="btnsExport">
      <div class="barra">
        <button id="xlsx" class="bt">⬇ Baixar Excel</button>
        <button id="imprimir" class="bt">🖨 Imprimir / salvar PDF</button>
        <div class="esp"></div>
        <button id="abrirEmail" class="bt pri">✉ Enviar por e-mail</button>
      </div>
      <div id="painelEmail" class="email oculto">
        <div><label for="para">Para (separe por vírgula)</label><input id="para" type="text" style="width:100%" placeholder="gerente@empresa.com, rh@empresa.com"></div>
        <div><label for="assunto">Assunto</label><input id="assunto" type="text" style="width:100%"></div>
        <div><button id="disparar" class="bt pri">Enviar agora</button></div>
        <div class="periodo" style="text-align:left">Abre o seu e-mail (Outlook, Gmail…) com o Excel anexado ou, se o aparelho não permitir, baixa o arquivo e preenche a mensagem para você anexar.</div>
      </div>
      <div id="msgEx" class="msg"></div>
    </div>
  </section>
</main>
<div id="zoom" class="zoom oculto"><img alt="Foto da entrada"></div>

<script type="module">
/* ============ CONFIGURAÇÃO ============ */
const FIREBASE_CONFIG = {
  apiKey: "AIzaSyDEQ44YQIQ2BU2ZmHKAi_GpIdJmirXpjZs",
  authDomain: "agi-apps-4935a.firebaseapp.com",
  projectId: "agi-apps-4935a",
  appId: "1:777497555994:web:65b7e4d7089ae9a78acda3",
};
const FUSO = "America/Sao_Paulo";
const ALMOCO_PADRAO_MIN = 60;      // igual ao app Jornada: horas = saída − entrada − 1 h fixa
const TIPOS = [["entrada", "Entrada"], ["saida_almoco", "Saída almoço"], ["volta_almoco", "Volta almoço"], ["saida", "Saída"]];
const NOME_TIPO = Object.fromEntries(TIPOS);
const MESES = ["Janeiro","Fevereiro","Março","Abril","Maio","Junho","Julho","Agosto","Setembro","Outubro","Novembro","Dezembro"];
const SDK = "10.12.2", SHEETJS = "https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js";

const DEMO = new URLSearchParams(location.search).has("demo");
const $ = (id) => document.getElementById(id);
const fmtHora = (d) => d ? d.toLocaleTimeString("pt-BR", { timeZone: FUSO, hour: "2-digit", minute: "2-digit" }) : "—";
const chaveDia = (d) => d.toLocaleDateString("sv-SE", { timeZone: FUSO });
const fmtDia = (k) => { const [a, m, d] = k.split("-"); const w = new Date(`${k}T12:00:00-03:00`).toLocaleDateString("pt-BR", { timeZone: FUSO, weekday: "short" }); return `${d}/${m} · ${w.replace(".", "")}`; };
const fmtMin = (m) => `${String(Math.floor(m / 60)).padStart(2, "0")}:${String(m % 60).padStart(2, "0")}`;
const pad = (n) => String(n).padStart(2, "0");

/* ============ FOLHA (21 → 20, nome = mês em que termina) ============ */
function folhaDe(ref) {        // ref: {a, m} (m 0-11) = mês em que a folha TERMINA
  const ini = new Date(Date.UTC(ref.a, ref.m - 1, 21)), fim = new Date(Date.UTC(ref.a, ref.m, 20));
  const t = (d) => `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`;
  const iniK = t(ini), fimK = t(fim);
  return { nome: `Folha de ${MESES[((ref.m % 12) + 12) % 12]} ${fim.getUTCFullYear()}`, iniK, fimK,
           de: new Date(`${iniK}T00:00:00-03:00`), ate: new Date(new Date(`${fimK}T00:00:00-03:00`).getTime() + 86400000),
           texto: `${iniK.split("-").reverse().join("/")} a ${fimK.split("-").reverse().join("/")}` };
}
function folhaAtualRef() {
  const [a, m, d] = chaveDia(new Date()).split("-").map(Number);
  return d >= 21 ? { a, m: m } : { a, m: m - 1 };     // m já é "mês seguinte" em base 0 quando d>=21
}
let ref = folhaAtualRef();
const mudarFolha = (n) => { ref = { a: ref.a, m: ref.m + n }; };

/* ============ BACKEND ============ */
async function criarBackendReal() {
  const base = `https://www.gstatic.com/firebasejs/${SDK}/`;
  const [{ initializeApp }, A, F] = await Promise.all([import(base + "firebase-app.js"), import(base + "firebase-auth.js"), import(base + "firebase-firestore.js")]);
  const app = initializeApp(FIREBASE_CONFIG), auth = A.getAuth(app), db = F.getFirestore(app);
  return {
    onUser: (cb) => A.onAuthStateChanged(auth, cb),
    login: (e, s) => A.signInWithEmailAndPassword(auth, e, s),
    logout: () => A.signOut(auth),
    async perfil(uid) { const s = await F.getDoc(F.doc(db, "usuarios", uid)); return s.exists() ? s.data() : null; },
    async pessoas() { return (await F.getDocs(F.collection(db, "usuarios"))).docs.map((d) => ({ uid: d.id, nome: d.data().nome || d.data().email, status: d.data().status })).filter((p) => p.status === "aprovado"); },
    async batidas(uid, de, ate) {
      const q = F.query(F.collection(db, "ponto", uid, "batidas"), F.where("criado_em", ">=", F.Timestamp.fromDate(de)), F.where("criado_em", "<", F.Timestamp.fromDate(ate)), F.orderBy("criado_em"));
      return (await F.getDocs(q)).docs.map((d) => ({ id: d.id, ...d.data(), criado_em: d.data().criado_em.toDate() }));
    },
  };
}
function criarBackendDemo() {
  const pessoas = [{ uid: "a", nome: "Danilo Fornazza" }, { uid: "b", nome: "Maria Souza" }, { uid: "c", nome: "João Pereira" }];
  const FOTO = "data:image/svg+xml;utf8," + encodeURIComponent("<svg xmlns='http://www.w3.org/2000/svg' width='160' height='100'><rect width='160' height='100' fill='#9db4c8'/><rect x='55' y='25' width='50' height='75' fill='#5d7a93'/><text x='80' y='18' font-size='11' text-anchor='middle' fill='#fff'>foto da entrada</text></svg>");
  const gerar = (p, i) => {
    const out = [], hoje = new Date();
    for (let k = 0; k < 60; k++) {
      const d = new Date(hoje.getTime() - k * 86400000); const dow = d.getUTCDay();
      if (dow === 0 || dow === 6 || (i === 2 && k % 7 === 3)) continue;
      const dia = chaveDia(d), mk = (t, hh, mm, extra) => out.push({ id: `${dia}${t}`, tipo: t, metodo: "gps", distancia: 40 + (k * 7) % 80, precisao: 12 + k % 15, nome: p.nome, criado_em: new Date(`${dia}T${pad(hh)}:${pad(mm)}:00-03:00`), ...extra });
      const home = (i === 1 && k % 5 === 2), foto = (i === 2 && k % 4 === 0);
      const ex = home ? { metodo: "justificativa", justificativa: "Home Office", distancia: undefined, precisao: undefined } : foto ? { metodo: "foto", foto: FOTO, distancia: undefined } : {};
      mk("entrada", 8 + (k % 2), 50 + (k % 9), ex); mk("saida_almoco", 12, k % 20, home ? ex : {}); mk("volta_almoco", 13, 5 + k % 12, home ? ex : {});
      if (!(i === 2 && k === 2)) mk("saida", 18, 5 + (k * 3) % 40, ex);
    }
    return out;
  };
  const todas = Object.fromEntries(pessoas.map((p, i) => [p.uid, gerar(p, i)]));
  let usuario = null, ouvinte = null;
  return {
    onUser: (cb) => { ouvinte = cb; setTimeout(() => cb(usuario), 0); },
    login: async () => { usuario = { uid: "a", email: "demo@agi" }; ouvinte(usuario); },
    logout: async () => { usuario = null; ouvinte(null); },
    perfil: async () => ({ nome: "Danilo (demo)", area: "TI", status: "aprovado" }),
    pessoas: async () => pessoas,
    batidas: async (uid, de, ate) => todas[uid].filter((b) => b.criado_em >= de && b.criado_em < ate).sort((x, y) => x.criado_em - y.criado_em),
  };
}

/* ============ DADOS → DIAS ============ */
function montarDias(batidas) {
  const porDia = new Map();
  for (const b of batidas) { const k = chaveDia(b.criado_em); (porDia.get(k) || porDia.set(k, []).get(k)).push(b); }
  return [...porDia.entries()].sort().map(([k, lista]) => {
    const pega = (t, ultima) => { const x = lista.filter((b) => b.tipo === t); return x.length ? (ultima ? x[x.length - 1] : x[0]).criado_em : null; };
    const e = pega("entrada"), sa = pega("saida_almoco"), va = pega("volta_almoco"), s = pega("saida", true);
    const completo = !!(e && sa && va && s);
    const min = e && s ? Math.max(0, Math.round((s - e) / 60000) - ALMOCO_PADRAO_MIN) : null;
    return { dia: k, e, sa, va, s, completo, min, lista, justs: [...new Set(lista.filter((b) => b.metodo === "justificativa").map((b) => b.justificativa))],
             metodos: [...new Set(lista.map((b) => b.metodo))] };
  });
}

/* ============ TELA ============ */
let B, folha, pessoas = [], dados = [];   // dados: [{pessoa, dias, resumo}]
function tagMetodo(m, just) {
  const t = document.createElement("span");
  t.className = "tag " + (m === "justificativa" ? "just" : "ok");
  t.textContent = m === "gps" ? "📍 local" : m === "foto" ? "📷 foto" : (just || "justificado");
  return t;
}
async function carregar() {
  folha = folhaDe(ref);
  $("tituloFolha").textContent = folha.nome; $("periodo").textContent = folha.texto;
  $("cabImpressao").firstChild.textContent = `Relatório de ponto · ${folha.nome} (${folha.texto})`;
  $("lista").innerHTML = '<div class="card vazio">Carregando…</div>';
  const alvo = $("pessoa").value ? pessoas.filter((p) => p.uid === $("pessoa").value) : pessoas;
  try {
    dados = await Promise.all(alvo.map(async (p) => {
      const dias = montarDias(await B.batidas(p.uid, folha.de, folha.ate));
      const total = dias.reduce((s, d) => s + (d.min || 0), 0);
      return { pessoa: p, dias, resumo: { dias: dias.length, incompletos: dias.filter((d) => !d.completo).length,
               justificados: dias.filter((d) => d.justs.length).length, min: total } };
    }));
  } catch (e) { $("lista").innerHTML = '<div class="card vazio erro">Não consegui carregar as batidas (sem permissão ou sem internet).</div>'; return; }
  desenhar();
}
function desenhar() {
  const T = dados.reduce((a, d) => ({ dias: a.dias + d.resumo.dias, inc: a.inc + d.resumo.incompletos, just: a.just + d.resumo.justificados, min: a.min + d.resumo.min }), { dias: 0, inc: 0, just: 0, min: 0 });
  $("kpis").innerHTML = "";
  for (const [rot, val] of [["Pessoas", dados.length], ["Dias com batida", T.dias], ["Horas trabalhadas", fmtMin(T.min)], ["Dias justificados", T.just], ["Dias incompletos", T.inc]]) {
    const k = document.createElement("div"); k.className = "kpi"; k.innerHTML = `<span></span><b></b>`; k.firstChild.textContent = rot; k.lastChild.textContent = val; $("kpis").appendChild(k);
  }
  const lista = $("lista"); lista.innerHTML = "";
  for (const { pessoa, dias, resumo } of dados) {
    const box = document.createElement("div"); box.className = "card pessoa";
    const cab = document.createElement("div"); cab.className = "cab";
    const h = document.createElement("h2"); h.textContent = pessoa.nome;
    const r = document.createElement("div"); r.className = "res";
    r.textContent = `${resumo.dias} dia(s) · ${fmtMin(resumo.min)} trabalhadas · ${resumo.justificados} justificado(s) · ${resumo.incompletos} incompleto(s)`;
    cab.append(h, r); box.appendChild(cab);
    if (!dias.length) { const v = document.createElement("div"); v.className = "vazio"; v.textContent = "Nenhuma batida nesta folha."; box.appendChild(v); lista.appendChild(box); continue; }
    const tb = document.createElement("table");
    tb.innerHTML = "<thead><tr><th class='esq'>Dia</th><th>Entrada</th><th>Saída alm.</th><th>Volta alm.</th><th>Saída</th><th>Horas</th><th class='esq'>Origem</th></tr></thead>";
    const corpo = document.createElement("tbody");
    for (const d of dias) {
      const tr = document.createElement("tr"); tr.className = "dia";
      const c = (txt, cls) => { const td = document.createElement("td"); if (cls) td.className = cls; td.textContent = txt; tr.appendChild(td); return td; };
      c(fmtDia(d.dia), "esq"); c(fmtHora(d.e)); c(fmtHora(d.sa)); c(fmtHora(d.va)); c(fmtHora(d.s)); c(d.min == null ? "—" : fmtMin(d.min));
      const o = document.createElement("td"); o.className = "esq";
      if (!d.completo) { const t = document.createElement("span"); t.className = "tag inc"; t.textContent = "incompleto"; o.appendChild(t); }
      for (const m of d.metodos) o.appendChild(tagMetodo(m, m === "justificativa" ? d.justs.join(", ") : ""));
      tr.appendChild(o); corpo.appendChild(tr);
      const det = document.createElement("tr"); det.className = "det oculto"; const td = document.createElement("td"); td.colSpan = 7;
      const ul = document.createElement("ul");
      for (const b of d.lista) {
        const li = document.createElement("li");
        const a = document.createElement("span"); a.textContent = `${fmtHora(b.criado_em)} · ${NOME_TIPO[b.tipo] || b.tipo}`; li.appendChild(a);
        li.appendChild(tagMetodo(b.metodo, b.justificativa));
        if (b.distancia != null) { const x = document.createElement("span"); x.className = "periodo"; x.textContent = `a ${b.distancia} m do escritório (GPS ±${b.precisao ?? "?"} m)`; li.appendChild(x); }
        if (b.foto) { const im = document.createElement("img"); im.src = b.foto; im.alt = "Foto da entrada"; im.onclick = (e) => { e.stopPropagation(); $("zoom").firstChild.src = b.foto; $("zoom").classList.remove("oculto"); }; li.appendChild(im); }
        ul.appendChild(li);
      }
      td.appendChild(ul); det.appendChild(td); corpo.appendChild(det);
      tr.onclick = () => det.classList.toggle("oculto");
    }
    tb.appendChild(corpo); box.appendChild(tb); lista.appendChild(box);
  }
  $("assunto").value = `Relatório de ponto · ${folha.nome}`;
}
$("zoom").onclick = () => $("zoom").classList.add("oculto");
$("ant").onclick = () => { mudarFolha(-1); carregar(); };
$("prox").onclick = () => { mudarFolha(+1); carregar(); };
$("pessoa").onchange = carregar;

/* ============ EXPORTAR ============ */
function carregarSheetJS() {
  if (window.XLSX) return Promise.resolve();
  return new Promise((ok, falha) => { const s = document.createElement("script"); s.src = SHEETJS; s.onload = ok; s.onerror = () => falha(new Error("sheetjs")); document.head.appendChild(s); });
}
async function montarExcel() {
  await carregarSheetJS();
  const resumo = [["Pessoa", "Dias com batida", "Horas trabalhadas", "Dias justificados", "Dias incompletos"]];
  const dias = [["Pessoa", "Dia", "Entrada", "Saída almoço", "Volta almoço", "Saída", "Horas trabalhadas", "Origem", "Observação"]];
  const batidas = [["Pessoa", "Data", "Hora (servidor)", "Tipo", "Método", "Distância do escritório (m)", "Precisão GPS (m)", "Justificativa"]];
  for (const { pessoa, dias: ds, resumo: r } of dados) {
    resumo.push([pessoa.nome, r.dias, fmtMin(r.min), r.justificados, r.incompletos]);
    for (const d of ds) {
      dias.push([pessoa.nome, d.dia.split("-").reverse().join("/"), fmtHora(d.e), fmtHora(d.sa), fmtHora(d.va), fmtHora(d.s), d.min == null ? "" : fmtMin(d.min),
        d.metodos.map((m) => m === "gps" ? "localização" : m === "foto" ? "foto" : "justificativa").join(" + "), (d.completo ? "" : "incompleto") + (d.justs.length ? (d.completo ? "" : " · ") + d.justs.join(", ") : "")]);
      for (const b of d.lista) batidas.push([pessoa.nome, d.dia.split("-").reverse().join("/"), fmtHora(b.criado_em), NOME_TIPO[b.tipo] || b.tipo,
        b.metodo === "gps" ? "localização" : b.metodo === "foto" ? "foto" : "justificativa", b.distancia ?? "", b.precisao ?? "", b.justificativa || ""]);
    }
  }
  const wb = XLSX.utils.book_new();
  for (const [nome, linhas, larg] of [["Resumo", resumo, [28, 16, 18, 18, 18]], ["Dias", dias, [28, 12, 10, 13, 13, 10, 17, 24, 30]], ["Batidas", batidas, [28, 12, 14, 14, 14, 26, 16, 24]]]) {
    const ws = XLSX.utils.aoa_to_sheet(linhas); ws["!cols"] = larg.map((w) => ({ wch: w })); XLSX.utils.book_append_sheet(wb, ws, nome);
  }
  const bytes = XLSX.write(wb, { bookType: "xlsx", type: "array" });
  const nomeArq = `Relatorio_ponto_${folha.nome.replace("Folha de ", "").replace(" ", "_")}.xlsx`;
  return new File([bytes], nomeArq, { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" });
}
function baixar(arq) { const a = document.createElement("a"); a.href = URL.createObjectURL(arq); a.download = arq.name; document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 4000); }
const aviso = (txt, cls = "ok") => { $("msgEx").className = "msg " + cls; $("msgEx").textContent = txt; };

$("xlsx").onclick = async () => {
  try { baixar(await montarExcel()); aviso("✓ Excel baixado."); } catch { aviso("Não consegui gerar o Excel (sem internet para carregar a biblioteca?).", "erro"); }
};
$("imprimir").onclick = () => window.print();
$("abrirEmail").onclick = () => { $("painelEmail").classList.toggle("oculto"); try { $("para").value = localStorage.getItem("ponto_para") || ""; } catch {} };
function corpoEmail() {
  const linhas = [`Segue o relatório de ponto da ${folha.nome} (${folha.texto}).`, ""];
  for (const { pessoa, resumo: r } of dados) linhas.push(`• ${pessoa.nome}: ${r.dias} dia(s), ${fmtMin(r.min)} trabalhadas, ${r.justificados} justificado(s), ${r.incompletos} incompleto(s)`);
  linhas.push("", "As batidas são registradas pelo celular, com horário do servidor e confirmação por localização, foto ou justificativa. O detalhe de cada batida está na aba \"Batidas\" do Excel.");
  return linhas.join("\n");
}
$("disparar").onclick = async () => {
  const para = $("para").value.trim(), assunto = $("assunto").value.trim() || "Relatório de ponto";
  try { localStorage.setItem("ponto_para", para); } catch {}
  let arq;
  try { arq = await montarExcel(); } catch { aviso("Não consegui gerar o Excel (sem internet para carregar a biblioteca?).", "erro"); return; }
  const corpo = corpoEmail();
  if (navigator.canShare && navigator.canShare({ files: [arq] })) {
    try { await navigator.share({ files: [arq], title: assunto, text: corpo }); aviso("✓ Escolha o e-mail na janela que abriu e confirme o envio."); return; }
    catch (e) { if (e && e.name === "AbortError") { aviso("Envio cancelado.", "erro"); return; } }
  }
  baixar(arq);
  const url = `mailto:${encodeURIComponent(para).replace(/%2C/g, ",").replace(/%40/g, "@")}?subject=${encodeURIComponent(assunto)}&body=${encodeURIComponent(corpo)}`;
  window.__ultimoMailto = url; location.href = url;
  aviso(`✓ Baixei "${arq.name}" e abri o e-mail. É só anexar o arquivo baixado e enviar.`);
};

/* ============ LOGIN ============ */
$("entrar").onclick = async () => {
  $("msgLogin").textContent = ""; $("entrar").disabled = true;
  try { await B.login($("email").value.trim(), $("senha").value); } catch { $("msgLogin").textContent = "E-mail ou senha incorretos."; }
  $("entrar").disabled = false;
};
$("senha").addEventListener("keydown", (e) => { if (e.key === "Enter") $("entrar").click(); });
$("sair").onclick = () => B.logout();
const tela = (t) => { $("login").classList.toggle("oculto", t !== "login"); $("painel").classList.toggle("oculto", t !== "painel"); $("sair").classList.toggle("oculto", t !== "painel"); };

(async function iniciar() {
  B = DEMO ? criarBackendDemo() : await criarBackendReal();
  $("demo").classList.toggle("oculto", !DEMO);
  B.onUser(async (u) => {
    if (!u) { tela("login"); $("quem").textContent = ""; return; }
    try {
      const p = await B.perfil(u.uid);
      if (!p || p.status !== "aprovado" || p.area !== "TI") { await B.logout(); tela("login"); $("msgLogin").textContent = "Esta página é só para a gestão (área TI)."; return; }
      $("quem").textContent = p.nome || u.email;
      pessoas = await B.pessoas();
      $("pessoa").innerHTML = '<option value="">Todas</option>' + pessoas.map((x) => `<option value="${x.uid}"></option>`).join("");
      [...$("pessoa").options].slice(1).forEach((o, i) => { o.textContent = pessoas[i].nome; });
      tela("painel"); await carregar();
    } catch { tela("login"); $("msgLogin").textContent = "Não consegui carregar. Tente de novo."; }
  });
})();
window.__gestao = { folhaDe, montarDias, get dados() { return dados; } };
</script>
